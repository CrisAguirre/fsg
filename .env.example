# URL absoluta del backend para el build de producción.
VITE_API_URL=http://localhost:8000
# Opcional en desarrollo: por defecto se usa el proxy de Vite (/api), que evita
# el bloqueo CORS del backend remoto. Solo define esta variable si quieres
# apuntar el dev server a otra API directamente.
# VITE_API_URL_DEV=http://localhost:8000
